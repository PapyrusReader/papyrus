{
	email {$ACME_EMAIL}
}

{$WEBSITE_DOMAIN} {
	reverse_proxy papyrus-website:8080
}

www.{$WEBSITE_DOMAIN} {
	redir https://{$WEBSITE_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	reverse_proxy papyrus-app:8080
}

{$API_DOMAIN} {
	@websiteHealth {
		path /health
		method GET
		header Origin https://{$WEBSITE_DOMAIN}
	}
	header @websiteHealth {
		Access-Control-Allow-Origin https://{$WEBSITE_DOMAIN}
		Cache-Control no-store
		defer
	}
	reverse_proxy papyrus-api:8080
}

{$SYNC_DOMAIN} {
	reverse_proxy papyrus-sync:8080
}
