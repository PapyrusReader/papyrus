#!/usr/bin/env bash
set -eu

usage() {
  printf 'Usage\n  %s VERSION ANDROID_BUILD       Start a release and follow its logs\n  %s logs VERSION ANDROID_BUILD  Show the latest logs and follow updates\n' "$0" "$0"
}

mode=start
case ${1:-} in
  start|logs) mode=$1; shift ;;
  -h|--help) usage; exit 0 ;;
esac

if [[ $# -ne 2 ]]; then
  usage >&2
  exit 2
fi

version=$1
build=$2
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ || ! $build =~ ^[1-9][0-9]*$ ]]; then
  printf 'Use a version such as 0.5.1 and a positive Android build number such as 10.\n' >&2
  exit 2
fi

# The remote shell expands these variables on Hetzner.
# shellcheck disable=SC2016
remote='set -eu
unit=$(systemd-escape --template=papyrus-release@.service -- "papyrus-$version+$build")
if [ "$mode" = start ]; then
  runuser -u papyrus-release -- /opt/papyrus-release/bin/release plan "$version" --android-build "$build"
  systemctl start "$unit"
fi
exec journalctl --unit "$unit" --lines 50 --follow'

exec ssh -t hetzner "mode=$mode version=$version build=$build; $remote"
