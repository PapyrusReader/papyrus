#!/usr/bin/env bash
set -eu

usage() {
  echo 'Usage: tools/release-host [start|logs] MAJOR.MINOR.PATCH ANDROID_BUILD'
  echo 'For a calculated bump, use tools/release-octopus minor release'
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  start) shift ;;
  logs)
    shift
    [[ $# == 2 ]] || { usage >&2; exit 2; }
    echo "Octopus deployment history: https://papyrus-reader.octopus.app/app#/Spaces-1/projects/papyrus/deployments"
    exit 0 ;;
esac
[[ $# == 2 && $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $2 =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
exec gh workflow run octopus.yml --repo PapyrusReader/papyrus --ref master -f mode=release -f "number=$1+$2"
