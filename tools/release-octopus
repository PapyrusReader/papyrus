#!/usr/bin/env bash
set -eu
bump=${1:-minor}
mode=${2:-preview}
case "$bump" in major|minor|patch) ;; *) echo 'Use major, minor, or patch' >&2; exit 2;; esac
case "$mode" in preview|release) ;; *) echo 'Use preview or release' >&2; exit 2;; esac
exec gh workflow run octopus.yml --repo PapyrusReader/papyrus --ref master -f "bump=$bump" -f "mode=$mode"
